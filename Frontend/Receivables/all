  const data = receivables.map((r) => ({
    x: r.daysLate ?? 0,
    y: r.probabilityOfPayment ?? 0,
    size: Math.max(4, Math.min(20, (r.amount / 5000) * 1)),
    fill: r.probabilityOfPayment !== null && r.probabilityOfPayment !== undefined
  ? r.probabilityOfPayment >= 90
    ? COLORS.INCOME
